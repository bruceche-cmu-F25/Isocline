{
  "name": "zirma",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source personal agent: one home node, every device a window onto it.",
  "license": "MIT",
  "homepage": "https://github.com/bruceche-cmu-F25/Zirma",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "zirma": "node packages/server/src/cli.ts",
    "start": "npm run build:ui && node packages/server/src/cli.ts serve",
    "trial": "ZIRMA_DATA_DIR=\"$(mktemp -d)\" ZIRMA_SECRETS=file ZIRMA_PORT=\"${ZIRMA_PORT:-7520}\" node packages/server/src/cli.ts serve",
    "dev:ui": "ZIRMA_PORT=\"${ZIRMA_PORT:-7520}\" npm run dev --workspace @zirma/ui -- --host 127.0.0.1",
    "prototype": "python3 -m http.server 4173 --bind 127.0.0.1 --directory prototype",
    "build:ui": "npm run build --workspace @zirma/ui",
    "test": "node --test \"packages/*/test/*.test.ts\" \"modules/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace @zirma/ui",
    "desktop": "npm run build:ui && electron packages/desktop",
    "package:mac": "node scripts/package-mac.ts",
    "install:mac": "node scripts/install-mac.ts",
    "dev:follow": "node scripts/follow-zirma.ts",
    "dev:copy-world": "node scripts/copy-world-to-dev.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
