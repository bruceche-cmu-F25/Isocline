{
  "name": "alfred",
  "private": true,
  "description": "An open-source personal agent: one home node, every device a window onto it.",
  "license": "MIT",
  "homepage": "https://github.com/bruceche-cmu-F25/Alfred",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "alfred": "node packages/server/src/cli.ts",
    "start": "npm run build:ui && node packages/server/src/cli.ts serve",
    "dev:ui": "npm run dev --workspace @alfred/ui",
    "build:ui": "npm run build --workspace @alfred/ui",
    "test": "node --test \"packages/*/test/*.test.ts\" \"modules/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace @alfred/ui",
    "desktop": "npm run build:ui && electron packages/desktop"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
