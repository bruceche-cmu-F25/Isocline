{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "isocline-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec env ISOCLINE_DATA_DIR=\"$(mktemp -d)\" ISOCLINE_SECRETS=file ISOCLINE_PORT=7520 node packages/server/src/cli.ts serve"
      ],
      "port": 7520,
      "url": "http://127.0.0.1:7520"
    },
    {
      "name": "isocline-ui",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ISOCLINE_PORT=7520", "npm", "run", "dev", "--workspace", "@isocline/ui", "--", "--host", "127.0.0.1"],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "isocline-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--directory", "prototype"],
      "port": 4173
    }
  ]
}
